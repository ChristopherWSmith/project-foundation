{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "foundation-handoff/v1",
  "title": "Implementer → reviewer handoff. Posted as a ```foundation-handoff fenced block in the PR description.",
  "type": "object",
  "required": ["schema", "task", "implementer", "summary", "commands", "next_action"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "foundation-handoff/v1" },
    "task": { "type": "string", "minLength": 1 },
    "plan": { "type": ["string", "null"] },
    "implementer": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 10 },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["cmd", "result"],
        "additionalProperties": false,
        "properties": {
          "cmd": { "type": "string", "minLength": 1 },
          "result": { "enum": ["pass", "fail", "not_run"] },
          "note": { "type": "string" }
        }
      }
    },
    "docs_updated": { "type": "array", "items": { "type": "string" } },
    "risks": { "type": "array", "items": { "type": "string" } },
    "open_questions": { "type": "array", "items": { "type": "string" } },
    "next_action": { "type": "string", "minLength": 1 }
  }
}
