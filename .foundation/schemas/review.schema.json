{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "foundation-review/v1",
  "title": "Independent review result. Posted as a ```foundation-review fenced block in the body of a GitHub PR review.",
  "type": "object",
  "required": ["schema", "head_sha", "verdict", "findings"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "foundation-review/v1" },
    "head_sha": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
    "verdict": { "enum": ["approve", "request_changes"] },
    "summary": { "type": "string" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "status", "summary"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["P0", "P1", "P2", "P3"] },
          "status": { "enum": ["open", "resolved", "accepted_risk"] },
          "file": { "type": "string" },
          "line": { "type": "integer", "minimum": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "failure_scenario": { "type": "string" },
          "fix": { "type": "string" }
        }
      }
    },
    "docs_exception": { "enum": ["accepted", "rejected", "n/a"] },
    "checks_verified": { "type": "array", "items": { "type": "string" } }
  }
}
