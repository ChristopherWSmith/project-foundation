# Names only — never real values. Real values live in Infisical:
#   /products/__PROJECT_SLUG__/<env>   app secrets
#   /agents/                             agent credentials
#   /mcp/                                MCP server credentials
# Every variable the code reads must be listed here (CI checks this).
# The typed schema in src/config/env.ts is the source of truth; keep the two in step.

# --- App ---
NODE_ENV=development
APP_URL=http://localhost:3000

# --- Database ---
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI ---
ANTHROPIC_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
