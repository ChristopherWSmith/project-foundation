{
  "$comment": "Independent review of the head commit (scripts/checks/review_gate.py posts the status). No bypass.",
  "name": "foundation: staging review gate",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "include": [
        "refs/heads/staging"
      ],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": false,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          {
            "context": "review-gate",
            "integration_id": 15368
          }
        ]
      }
    }
  ]
}
