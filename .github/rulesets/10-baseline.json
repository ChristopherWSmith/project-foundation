{
  "$comment": "No bypass for anyone. PRs only, no force-push or deletion, threads resolved, CI checks from GitHub Actions. apply-protection.py --with adds extra checks here.",
  "name": "foundation: baseline (staging + main)",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "include": [
        "refs/heads/staging",
        "refs/heads/main"
      ],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": false,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": true,
        "allowed_merge_methods": [
          "merge",
          "squash"
        ]
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": false,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          {
            "context": "checks",
            "integration_id": 15368
          },
          {
            "context": "security_staging",
            "integration_id": 15368
          },
          {
            "context": "drift",
            "integration_id": 15368
          },
          {
            "context": "selftest",
            "integration_id": 15368
          }
        ]
      }
    }
  ]
}
